SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# GitHub owner (user or org) for created repos
# ex) GITHUB_OWNER=yourname
GITHUB_OWNER=

# Host path of the workspace directory (absolute path on the host machine)
# ex) HOST_WORKSPACE=/home/yourname/workspace
HOST_WORKSPACE=

# Mount target path inside the container
# ex) WORKSPACE_DIR=/workspace
WORKSPACE_DIR=

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Slack channel ID for system notifications (token expiry warnings, etc.)
# ex) SLACK_NOTIFY_CHANNEL=C0ARFTFNB42
SLACK_NOTIFY_CHANNEL=
